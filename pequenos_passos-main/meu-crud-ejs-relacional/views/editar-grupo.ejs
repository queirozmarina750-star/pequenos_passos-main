<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Grupo</title>
</head>
<body>

    <h1>Editar Grupo</h1>

    <form action="/grupos/editar/<%= grupo.id %>" method="POST">

        <label>Nome do Grupo:</label>
        <input
            type="text"
            name="nome_grupo"
            value="<%= grupo.nome_grupo %>"
            required
        >

        <br><br>

        <label>Descrição:</label>
        <input
            type="text"
            name="descricao"
            value="<%= grupo.descricao %>"
            required
        >

        <br><br>

        <button type="submit">Atualizar</button>

    </form>

    <a href="/grupos">Voltar</a>

</body>
</html>